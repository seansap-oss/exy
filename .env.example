# Public Vite configuration. These values are compiled into the browser/APK.
# Use the Supabase Project URL and the public anon/publishable key only.
# Never put the service_role key in this file or in Vercel VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
