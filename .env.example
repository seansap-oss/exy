# ============================================================================
# EXY — environment configuration
# Copy to .env.local and fill in. All values are optional: without them the
# app runs in a fully-functional local demo mode backed by localStorage.
# ============================================================================

# Module 1 — Supabase (auth, profiles, listings, messaging, analytics, storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Module 5 — Razorpay (INR payments: UPI, net banking, cards)
# The secret key must NEVER be exposed to the client — order creation happens
# server-side. Only the public key id belongs here.
VITE_RAZORPAY_KEY_ID=rzp_test_EXYDEMOKEY01

# Module 7.2 - PayU (alternative Indian gateway)
VITE_PAYU_MERCHANT_KEY=payu_test_EXYDEMO
