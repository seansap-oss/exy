{
  "name": "exy",
  "private": true,
  "version": "1.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "env:check": "node scripts/verify-supabase-env.mjs",
    "backend:check": "node scripts/check-supabase-live.mjs",
    "build:release": "npm run env:check && npm run build",
    "verify:release": "npm run env:check && oxlint src api && tsc -b && vite build",
    "android:prepare": "npm run build:release && npx cap copy android",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:watch": "node scripts/build-watch.mjs",
    "verify": "oxlint && tsc -b && vite build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.7",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
